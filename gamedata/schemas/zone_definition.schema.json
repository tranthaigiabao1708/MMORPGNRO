{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-universe.dev/schemas/zone_definition.schema.json",
  "title": "ZoneDefinitions",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/ZoneDefinition"
  },
  "$defs": {
    "WorldBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x", "max_x", "min_y", "max_y", "min_z", "max_z", "kill_z"],
      "properties": {
        "min_x": { "type": "number" },
        "max_x": { "type": "number" },
        "min_y": { "type": "number" },
        "max_y": { "type": "number" },
        "min_z": { "type": "number" },
        "max_z": { "type": "number" },
        "kill_z": { "type": "number" }
      }
    },
    "SubzoneBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x", "max_x", "min_y", "max_y", "min_z", "max_z"],
      "properties": {
        "min_x": { "type": "number" },
        "max_x": { "type": "number" },
        "min_y": { "type": "number" },
        "max_y": { "type": "number" },
        "min_z": { "type": "number" },
        "max_z": { "type": "number" }
      }
    },
    "SpawnCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "group_count", "entities_per_group", "respawn_time_sec"],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^(mob|boss)\\.[a-z0-9_]+$"
        },
        "group_count": { "type": "integer", "minimum": 1 },
        "entities_per_group": { "type": "integer", "minimum": 1 },
        "respawn_time_sec": { "type": "number", "minimum": 1 }
      }
    },
    "SubzoneSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subzone_id",
        "is_safe_zone",
        "recommended_level_min",
        "recommended_level_max",
        "bounds_cm",
        "spawns"
      ],
      "properties": {
        "subzone_id": {
          "type": "string",
          "pattern": "^subzone\\.[a-z0-9_]+$"
        },
        "is_safe_zone": { "type": "boolean" },
        "recommended_level_min": { "type": "integer", "minimum": 1, "maximum": 100 },
        "recommended_level_max": { "type": "integer", "minimum": 1, "maximum": 100 },
        "bounds_cm": { "$ref": "#/$defs/SubzoneBounds" },
        "spawns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpawnCluster"
          }
        }
      }
    },
    "ZoneDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "planet_id",
        "ue5_level_name",
        "scope_status",
        "recommended_level_min",
        "recommended_level_max",
        "soft_cap_ccu",
        "hard_cap_ccu",
        "world_bounds_cm",
        "subzones"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^zone\\.[a-z0-9_]+$"
        },
        "planet_id": {
          "type": "string",
          "pattern": "^planet\\.[a-z0-9_]+$"
        },
        "ue5_level_name": {
          "type": "string",
          "pattern": "^L_[A-Za-z0-9_]+$"
        },
        "scope_status": {
          "type": "string",
          "enum": ["VERTICAL_SLICE_FULL", "MVP_STUB_IN_VS", "POST_MVP"]
        },
        "recommended_level_min": { "type": "integer", "minimum": 1, "maximum": 100 },
        "recommended_level_max": { "type": "integer", "minimum": 1, "maximum": 100 },
        "soft_cap_ccu": { "type": "integer", "minimum": 1, "maximum": 500 },
        "hard_cap_ccu": { "type": "integer", "minimum": 1, "maximum": 500 },
        "world_bounds_cm": { "$ref": "#/$defs/WorldBounds" },
        "subzones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SubzoneSpec"
          }
        }
      }
    }
  }
}
