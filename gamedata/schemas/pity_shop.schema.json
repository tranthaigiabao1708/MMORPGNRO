{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-universe.dev/schemas/pity_shop.schema.json",
  "title": "PityShopEntries",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/PityShopEntry"
  },
  "$defs": {
    "PityShopEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "token_item_id",
        "token_cost",
        "standard_coin_cost",
        "reward_item_id",
        "reward_quantity",
        "daily_limit"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^pity\\.[a-z0-9_]+$"
        },
        "token_item_id": {
          "type": "string",
          "pattern": "^token\\.[a-z0-9_]+$"
        },
        "token_cost": { "type": "integer", "minimum": 1 },
        "standard_coin_cost": { "type": "integer", "minimum": 0 },
        "reward_item_id": {
          "type": "string",
          "pattern": "^item\\.[a-z0-9_]+$"
        },
        "reward_quantity": { "type": "integer", "minimum": 1 },
        "daily_limit": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    }
  }
}
