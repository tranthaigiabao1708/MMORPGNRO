{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-universe.dev/schemas/exp_table.schema.json",
  "title": "ExpTable",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/ExpLevelEntry"
  },
  "$defs": {
    "ExpLevelEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "exp_to_next",
        "cumulative_exp",
        "mastery_reward"
      ],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "exp_to_next": { "type": "integer", "minimum": 0 },
        "cumulative_exp": { "type": "integer", "minimum": 0 },
        "mastery_reward": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
