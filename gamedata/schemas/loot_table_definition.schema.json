{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-universe.dev/schemas/loot_table_definition.schema.json",
  "title": "LootTableDefinitions",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/LootTableDefinition"
  },
  "$defs": {
    "LootEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_type",
        "ref_id",
        "weight",
        "min_qty",
        "max_qty"
      ],
      "properties": {
        "entry_type": {
          "type": "string",
          "enum": ["ITEM", "SUB_TABLE", "NOTHING"]
        },
        "ref_id": {
          "type": ["string", "null"],
          "pattern": "^(item|token|loot)\\.[a-z0-9_]+$"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "min_qty": { "type": "integer", "minimum": 0 },
        "max_qty": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "entry_type": { "const": "NOTHING" } },
            "required": ["entry_type"]
          },
          "then": {
            "properties": {
              "ref_id": { "type": "null" },
              "min_qty": { "const": 0 },
              "max_qty": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "entry_type": { "const": "ITEM" } },
            "required": ["entry_type"]
          },
          "then": {
            "properties": {
              "ref_id": {
                "type": "string",
                "pattern": "^(item|token)\\.[a-z0-9_]+$"
              },
              "min_qty": { "minimum": 1 },
              "max_qty": { "minimum": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "entry_type": { "const": "SUB_TABLE" } },
            "required": ["entry_type"]
          },
          "then": {
            "properties": {
              "ref_id": {
                "type": "string",
                "pattern": "^loot\\.[a-z0-9_]+$"
              },
              "min_qty": { "minimum": 1 },
              "max_qty": { "minimum": 1 }
            }
          }
        }
      ]
    },
    "RollGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "group_trigger_chance",
        "pick_count",
        "entries"
      ],
      "properties": {
        "group_id": { "type": "string", "minLength": 1 },
        "group_trigger_chance": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "pick_count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LootEntry"
          }
        }
      }
    },
    "LootTableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loot_table_id",
        "loot_distribution_mode",
        "roll_groups"
      ],
      "properties": {
        "loot_table_id": {
          "type": "string",
          "pattern": "^loot\\.[a-z0-9_]+$"
        },
        "loot_distribution_mode": {
          "type": "string",
          "enum": ["PERSONAL_INSTANCED", "PARTY_ROUND_ROBIN"]
        },
        "roll_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RollGroup"
          }
        }
      }
    }
  }
}
