{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-universe.dev/schemas/enhance_curve_definition.schema.json",
  "title": "EnhanceCurveDefinitions",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/EnhanceTierRule"
  },
  "$defs": {
    "EnhanceTierRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_level",
        "cumulative_stat_bonus_pct",
        "success_rate_bp",
        "bonus_bp_per_pity",
        "hard_pity_threshold",
        "standard_coin_cost",
        "material_item_id",
        "material_count",
        "downgrade_on_fail",
        "downgrade_floor_level"
      ],
      "properties": {
        "target_level": { "type": "integer", "minimum": 1, "maximum": 15 },
        "cumulative_stat_bonus_pct": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "success_rate_bp": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "bonus_bp_per_pity": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "hard_pity_threshold": { "type": "integer", "minimum": 0, "maximum": 50 },
        "standard_coin_cost": { "type": "integer", "minimum": 0 },
        "material_item_id": {
          "type": "string",
          "pattern": "^item\\.[a-z0-9_]+$"
        },
        "material_count": { "type": "integer", "minimum": 1 },
        "downgrade_on_fail": { "type": "integer", "minimum": 0, "maximum": 3 },
        "downgrade_floor_level": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    }
  }
}
