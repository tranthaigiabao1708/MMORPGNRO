{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-universe.dev/schemas/item_set_definition.schema.json",
  "title": "ItemSetDefinitions",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/ItemSetDefinition"
  },
  "$defs": {
    "StatModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attr_id", "op", "value"],
      "properties": {
        "attr_id": {
          "type": "string",
          "pattern": "^(attr|pot)\\.[a-z0-9_]+$"
        },
        "op": {
          "type": "string",
          "enum": ["ADD_FLAT", "ADD_PCT", "MULT"]
        },
        "value": { "type": "number" }
      }
    },
    "SetBonusTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_pieces", "stat_modifiers", "effect_id"],
      "properties": {
        "required_pieces": { "type": "integer", "minimum": 2, "maximum": 8 },
        "stat_modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatModifier"
          }
        },
        "effect_id": {
          "type": ["string", "null"],
          "pattern": "^effect\\.[a-z0-9_]+$"
        }
      }
    },
    "ItemSetDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set_id",
        "required_level",
        "piece_item_ids",
        "bonuses"
      ],
      "properties": {
        "set_id": {
          "type": "string",
          "pattern": "^set\\.[a-z0-9_]+$"
        },
        "required_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "piece_item_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^item\\.[a-z0-9_]+$"
          }
        },
        "bonuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SetBonusTier"
          }
        }
      }
    }
  }
}
