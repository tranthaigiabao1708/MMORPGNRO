<?xml version="1.0" encoding="utf-8" ?>
<Configuration xmlns="https://www.unrealengine.com/BuildConfiguration">
	<!-- Tuned for Primary Workstation: Intel Core i5-14600KF (14C/20T) + 32 GB RAM -->
	<!-- Uses up to 18 parallel actions (1.5 GB ceiling each = ~27 GB max) keeping OS/Editor responsive -->
	<ParallelExecutor>
		<MaxProcessorCount>18</MaxProcessorCount>
		<ProcessorCountMultiplier>1.0</ProcessorCountMultiplier>
		<MemoryPerActionBytes>1610612736</MemoryPerActionBytes>
	</ParallelExecutor>
	<BuildConfiguration>
		<bAllowXGE>false</bAllowXGE>
		<bAllowFASTBuild>false</bAllowFASTBuild>
	</BuildConfiguration>
</Configuration>
